{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sumo Logic accessKeyManagement serviceMap API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "serviceMap",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get A Service Map.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.au.sumologic.com/api/v1/tracing/serviceMap"
          },
          "docs": "Run a search request to get a map of services and connections between them."
        }
      ]
    }
  ],
  "bundled": true
}