              {
                "name": "budgetId",
                "value": "",
                "type": "path",
                "description": "The id of the budget."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update budget"
        },
        {
          "info": {
            "name": "Delete Budget",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.au.sumologic.com/api/v1/budgets/:budgetId",
            "params": [
              {
                "name": "budgetId",
                "value": "",
                "type": "path",
                "description": "The id of the budget."
              }
            ]
          },
          "docs": "Delete budget"
