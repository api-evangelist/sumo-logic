{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sumo Logic accessKeyManagement passwordPolicy API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "passwordPolicy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get The Current Password Policy.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.au.sumologic.com/api/v1/passwordPolicy"
          },
          "docs": "Get the current password policy."
        },
        {
          "info": {
            "name": "Update Password Policy.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.au.sumologic.com/api/v1/passwordPolicy",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the current password policy."
        }
      ]
    }
  ],
  "bundled": true
}