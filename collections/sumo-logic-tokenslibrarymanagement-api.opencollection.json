{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sumo Logic accessKeyManagement tokensLibraryManagement API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "tokensLibraryManagement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get A List Of Tokens.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.au.sumologic.com/api/v1/tokens"
          },
          "docs": "Get a list of all tokens in the token library."
        },
        {
          "info": {
            "name": "Create A Token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.au.sumologic.com/api/v1/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a token in the token library."
        },
        {
          "info": {
            "name": "Get A Token.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.au.sumologic.com/api/v1/tokens/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the token to return."
              }
            ]
          },
          "docs": "Get a token with the given identifier in the token library."
        },
        {
          "info": {
            "name": "Update A Token.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.au.sumologic.com/api/v1/tokens/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the token to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a token with the given identifier in the token library."
        },
        {
          "info": {
            "name": "Delete A Token.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.au.sumologic.com/api/v1/tokens/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the token to delete."
              }
            ]
          },
          "docs": "Delete a token with the given identifier in the token library."
        }
      ]
    }
  ],
  "bundled": true
}