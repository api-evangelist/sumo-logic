            {
              "name": "Get A List Of Ingest Budgets",
              "id": "be655ec6-1a0b-4c4e-b2f6-8c3a5c9db4e7",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v2/ingestBudgets?limit=100&token=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v2",
                    "ingestBudgets"
                  ],
                  "query": [
                    {
                      "description": "Limit the number of budgets returned in the response. The number of budgets returned may be less than the `limit`.",
                      "key": "limit",
                      "value": "100"
                    },
                    {
                      "description": "Continuation token to get the next page of results. A page object with the next continuation token is returned in the response body. Subsequent GET requests should specify the continuation token to get the next page of results.",
                      "key": "token",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Get a list of all ingest budgets. The response is paginated with a default limit of 100 budgets per page."
              },
              "response": [
                {
                  "id": "01e39e3c-a698-4bd4-823d-82eed3452948",
                  "name": "A paginated list of budgets.",
